          <line x1="110" y1="30" x2="200" y2="70" stroke="#262A31" stroke-width="1"/>
          <line x1="20" y1="70" x2="110" y2="110" stroke="#262A31" stroke-width="1"/>
          <line x1="110" y1="110" x2="200" y2="70" stroke="#262A31" stroke-width="1"/>
