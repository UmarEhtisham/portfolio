        <text x="300" y="80" text-anchor="middle" fill="#E8A33D" font-family="Space Grotesk, sans-serif" font-size="13" font-weight="500">Agents</text>
        <text x="540" y="80" text-anchor="middle" fill="#3FA796" font-family="Space Grotesk, sans-serif" font-size="13" font-weight="500">Platforms</text>
